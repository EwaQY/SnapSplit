# ============================================================
# SnapSplit 本地环境变量模板（提交用）
# 用法：复制为同目录下的 .env 后填值（.env 已忽略，永不提交）
#   Copy-Item .env.example .env
# ============================================================

# ---- AI 模型配置（可选，用于智能账单解析） ----

# API 基地址（Cline 兼容接口，默认 https://api.cline.bot/api/v1）
base_url=https://api.cline.bot/api/v1

# 模型 ID（如 deepseek/deepseek-v4-flash）
model_id=

# Cline API Key（必填，否则 AI 解析不可用）
api_key=
